# ─── Payment gateways (serverless /api functions) ───
# Polar.sh is the primary gateway. Create a Product in the Polar dashboard,
# then put its ID below. The checkout handler creates a price per bid amount.
POLAR_ACCESS_TOKEN=
POLAR_ORGANIZATION_ID=
POLAR_PRODUCT_ID=
# Use Polar's sandbox API by setting this to the sandbox base URL:
# POLAR_API_URL=https://sandbox-api.polar.sh/v1

# Optional secondary gateway
STRIPE_SECRET_KEY=

# ─── Server-side leaderboard persistence ───
# Upstash Redis (free tier) — serverless-safe. If unset, a local .data/bids.json
# file is used (dev/demo only; NOT durable on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Frontend ───
VITE_API_URL=
VITE_WS_URL=
