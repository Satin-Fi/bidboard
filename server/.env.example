# Server environment (copy to .env). All values have safe defaults.
PORT=4000
# Secret used to sign JWTs. CHANGE THIS in production.
JWT_SECRET=dev-bidboard-secret-change-me
# Comma-separated list of allowed CORS origins (frontend). * for local dev.
CORS_ORIGIN=*
# Path to the JSON data file used as the repository.
DATA_FILE=./data/db.json
# Seed the repository on first start if it is empty.
AUTO_SEED=true
